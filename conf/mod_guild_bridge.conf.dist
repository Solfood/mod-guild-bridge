[worldserver]

########################################
# mod-guild-bridge (guildmaster)
########################################

#    GuildBridge.Enable
#        Description: Turn the whole bridge on or off (events, orders, snapshots, incidents).
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

GuildBridge.Enable = 1

#    GuildmasterDatabaseInfo
#        Description: Connection to THIS world's guildmaster database: "host;port;user;password;database".
#                     Each world has its own database (spec §2b saves). On the dev server it comes from the
#                     AC_GUILDMASTER_DATABASE_INFO environment variable (docker-compose.override.yml), so the
#                     password never sits in this file.
#        Default:     "127.0.0.1;3306;acore;acore;guildmaster"

GuildmasterDatabaseInfo = "127.0.0.1;3306;acore;acore;guildmaster"

#    GuildmasterDatabase.WorkerThreads / GuildmasterDatabase.SynchThreads
#        Description: Async writer threads and sync connections for the guildmaster pool. Keep WorkerThreads
#                     at 1: the bridge relies on its writes being applied in order. The same holds for the
#                     core's CharacterDatabase.WorkerThreads (worldserver.conf). With either above 1 the bridge
#                     stays off and logs "GUILDBRIDGE disabled: ..." (the world still runs, without the bridge).
#        Default:     1 / 1

GuildmasterDatabase.WorkerThreads = 1
GuildmasterDatabase.SynchThreads = 1

#    GuildBridge.WorldId
#        Description: This world's id (a-z, 0-9, _ and -, at most 32). Stamped into the guildmaster database at
#                     the first boot; a later boot with another id refuses to start (one save per world).
#                     The world controller (Plan 2b) sets it per world (AC_GUILD_BRIDGE_WORLD_ID).
#        Default:     "w1"

GuildBridge.WorldId = "w1"

#    GuildBridge.TestAccount
#        Description: The normal (non-bot) account that holds clones: throwaway copies of bots for risky tests
#                     (`.bridge clone`, `.bridge testbots login|logout`). Create it once with `account create`.
#        Default:     "GMTEST"

GuildBridge.TestAccount = "GMTEST"

#    GuildBridge.LeaderAccount
#        Description: The normal (non-bot) account that holds the user guild's leader (create_guild with role
#                     "user"). The leader is made there, founds the guild and never logs in again. The bridge
#                     creates the account at startup when it is missing (random password, nobody logs in).
#        Default:     "GMGUILD"

GuildBridge.LeaderAccount = "GMGUILD"

#    GuildBridge.FounderAccounts
#        Description: This world's founder accounts, comma-separated names (create_founders puts one founder on
#                     each, the emptiest first). Set per world by the world controller. They must not start with
#                     AiPlayerbot.RandomBotAccountPrefix: the bot factory fills those. The bridge creates missing
#                     ones at startup and adds them to the population's accounts, so founders are population bots
#                     (logged in and kept by playerbots, FixedPopulation rules).
#        Default:     "" (none: create_founders fails with "no founder accounts")

GuildBridge.FounderAccounts = ""

#    GuildBridge.Population.ReadyShare
#        Description: world_status.population_ready_at is set the first time at least this % of the population
#                     is online after a boot. Advisory: the world controller decides readiness itself from
#                     population_online / population_size (preflight C7).
#        Default:     95

GuildBridge.Population.ReadyShare = 95

#    GuildBridge.Snapshot.KeepDays
#        Description: Per-bot snapshots (player dumps in bot_snapshots) older than this many days are deleted at
#                     startup and after every snapshot_all order; a bot's newest snapshot is always kept.
#                     0 keeps every snapshot.
#        Default:     14

GuildBridge.Snapshot.KeepDays = 14

#    GuildBridge.Snapshot.PerTick
#        Description: Snapshot orders over many bots (snapshot of a guild, snapshot_all) start this many bot
#                     snapshots per world tick. Each one saves an online bot on the world thread (about 0.5-1 ms),
#                     so 1 keeps a 1000-bot snapshot_all from stalling any tick. At least 1.
#        Default:     1

GuildBridge.Snapshot.PerTick = 1

#    GuildBridge.Events.FlushMs
#        Description: Game hooks queue events in memory; every this many milliseconds the world thread hands the
#                     queue to the guildmaster pool's writer thread as one transaction. At least 100.
#        Default:     1000

GuildBridge.Events.FlushMs = 1000

#    GuildBridge.Events.QueueCap
#        Description: At most this many events wait for the next flush. Events beyond it are not queued; they
#                     are counted as dropped (`.bridge status` dropped=), so a flood can't grow memory without limit.
#        Default:     10000

GuildBridge.Events.QueueCap = 10000

#    GuildBridge.Firsts.LevelStep
#        Description: Server firsts for levels are claimed at every multiple of this level (10, 20, ... 80).
#                     Test-guild and test-account characters never claim firsts. 0 turns level firsts off.
#        Default:     10

GuildBridge.Firsts.LevelStep = 10

#    GuildBridge.Dungeon.TravelMaxDistance
#        Description: A run_dungeon party travels to the dungeon's outdoor entrance (walking and riding, fighting
#                     on the way) when every member is on the entrance's continent and at most this many yards
#                     away from it. Otherwise it is teleported there. An order with "approach":"travel" travels
#                     from any distance on the same continent; "teleport" always teleports.
#        Default:     1500

GuildBridge.Dungeon.TravelMaxDistance = 1500

#    GuildBridge.Dungeon.TravelTimeoutS
#        Description: Travel time limit in seconds. Members still on the way then are teleported to the entrance
#                     (a run_teleport event, reason travel_timeout). At least 60.
#        Default:     1800

GuildBridge.Dungeon.TravelTimeoutS = 1800

#    GuildBridge.Dungeon.DeadWaitS
#        Description: A member who dies on the way (a run_ambush event) does its own corpse run; the group waits
#                     this many seconds for it to be alive again, then the run is abandoned.
#        Default:     600

GuildBridge.Dungeon.DeadWaitS = 600

#    GuildBridge.Dungeon.LevelBelow
#    GuildBridge.Dungeon.LevelAbove
#        Description: Every member's level must be within the dungeon's recommended level (its heroic level for
#                     a heroic run) minus LevelBelow and plus LevelAbove.
#        Default:     5, 5

GuildBridge.Dungeon.LevelBelow = 5
GuildBridge.Dungeon.LevelAbove = 5

#    GuildBridge.Dungeon.MaxConcurrentRuns
#        Description: Dungeon runs that may be in progress at the same time (each live run costs world tick
#                     time). An order beyond it fails with "too many dungeon runs in progress (max <n>)". A bot
#                     is in at most one run at a time. Never above mod-dungeon-clear's own limit
#                     (DungeonClear.TestRun.MaxConcurrent, 0 = unlimited): a larger value is lowered to it at
#                     startup (logged).
#        Default:     3

GuildBridge.Dungeon.MaxConcurrentRuns = 3

#    GuildBridge.Dungeon.OverallTimeoutS
#        Description: A run that has no result after this many seconds is abandoned and its bots are released.
#                     At least 600.
#        Default:     9000

GuildBridge.Dungeon.OverallTimeoutS = 9000

#    GuildBridge.Stuck.Enable
#        Description: Look for stuck bots and record them in guildmaster.incidents (the first piece of
#                     GM-BOTAI's stuck-bot toolkit). Every ScanS seconds every online bot (population and
#                     guild; not the test account's clones) is looked at, spread over world ticks (PerTick
#                     bots per tick). An incident opens when a bot has been dead for DeadS, has made no
#                     progress for NoProgressS (not moved MoveYards from where it last made progress, and no
#                     XP, level or money change), or has hit playerbots' "stuck -> teleport" fallback
#                     PathFails times within PathWindowS. It closes when the condition clears, when the bot
#                     logs out, or at a restart. Bots in a dungeon run, held, being restored, in a raising, or
#                     inside a dungeon or battleground are not judged for "no progress" (the other kinds still
#                     open, with that context in the details).
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

GuildBridge.Stuck.Enable = 1

#    GuildBridge.Stuck.DeadS
#    GuildBridge.Stuck.NoProgressS
#        Description: Seconds dead (dead_long) and seconds without progress (no_progress). At least 1.
#        Default:     600, 900

GuildBridge.Stuck.DeadS = 600
GuildBridge.Stuck.NoProgressS = 900

#    GuildBridge.Stuck.MoveYards
#        Description: A move of more than this many yards from where the bot last made progress counts as
#                     progress.
#        Default:     40

GuildBridge.Stuck.MoveYards = 40

#    GuildBridge.Stuck.PathFails
#    GuildBridge.Stuck.PathWindowS
#        Description: path_fail opens after this many stuck teleports (the fork's counter) within the window
#                     (seconds, at least 60), and closes once none is left in the window.
#        Default:     3, 900

GuildBridge.Stuck.PathFails = 3
GuildBridge.Stuck.PathWindowS = 900

#    GuildBridge.Stuck.ScanS
#    GuildBridge.Stuck.PerTick
#        Description: Seconds between looks at every bot (at least 10), and bots judged per world tick (at
#                     least 1; 1000 bots at 100 per tick take 10 ticks).
#        Default:     60, 100

GuildBridge.Stuck.ScanS = 60
GuildBridge.Stuck.PerTick = 100
